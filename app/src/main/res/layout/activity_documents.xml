<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white_1"
    tools:context=".view.Approval.DocumentsActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/documnets_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/value_60dp"
        android:paddingStart="@dimen/value_10dp"
        />

    <TextView
        android:id="@+id/attachments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/attachmnets"
        android:textColor="@color/hint_color"
        android:fontFamily="@font/inter_font"
        android:textSize="@dimen/value_13dp"
        android:layout_marginTop="@dimen/value_34dp"
        android:layout_marginStart="@dimen/value_24dp"
        android:textFontWeight="@integer/medium"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/medical_certificate_link"
        android:layout_width="match_parent"
        android:layout_height="@dimen/value_34dp"
        app:cardCornerRadius="@dimen/value_10dp"
        app:cardElevation="@dimen/value_0dp"
        android:backgroundTint="@color/blue_1"
        android:layout_marginStart="@dimen/value_24dp"
        android:layout_marginEnd="@dimen/value_24dp"
        android:layout_marginTop="@dimen/value_16dp"
        android:clickable="true"
        android:focusable="true">

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/value_30dp"
        android:layout_height="@dimen/value_30dp"
        android:layout_margin="@dimen/value_2dp"
        app:cardCornerRadius="@dimen/value_8dp"
        android:backgroundTint="@color/blue_2"
        app:cardElevation="@dimen/value_0dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/clip"
            android:layout_gravity="center"/>
    </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/medical_certificate"
            android:layout_gravity="center_vertical"
            android:textColor="@color/blue"
            android:fontFamily="@font/inter_font"
            android:textSize="@dimen/value_13dp"
            android:layout_marginStart="@dimen/value_40dp"
            android:textFontWeight="@integer/medium"/>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/value_34dp"
        app:cardCornerRadius="@dimen/value_10dp"
        app:cardElevation="@dimen/value_0dp"
        android:backgroundTint="@color/blue_1"
        android:layout_marginStart="@dimen/value_24dp"
        android:layout_marginEnd="@dimen/value_24dp"
        android:layout_marginTop="@dimen/value_16dp"
        android:clickable="true"
        android:focusable="true">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/value_30dp"
            android:layout_height="@dimen/value_30dp"
            android:layout_margin="@dimen/value_2dp"
            app:cardCornerRadius="@dimen/value_8dp"
            android:backgroundTint="@color/blue_2"
            app:cardElevation="@dimen/value_0dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/clip"
                android:layout_gravity="center"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/certificate"
            android:layout_gravity="center_vertical"
            android:textColor="@color/blue"
            android:fontFamily="@font/inter_font"
            android:textSize="@dimen/value_13dp"
            android:layout_marginStart="@dimen/value_40dp"
            android:textFontWeight="@integer/medium"/>
    </androidx.cardview.widget.CardView>



</LinearLayout>