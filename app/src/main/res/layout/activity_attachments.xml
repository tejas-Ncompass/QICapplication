<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white_1"
    tools:context=".view.Approval.AttachmentsActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/attachments_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/value_60dp"
        android:paddingStart="@dimen/value_10dp"
        app:titleTextColor="@color/hint_color"
        app:titleTextAppearance="@style/ToolbarTextStyle"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="@dimen/value_100dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/medical_certificate"
            android:fontFamily="@font/inter_font"
            android:textSize="@dimen/value_17dp"
            android:textColor="@color/black"
            android:textFontWeight="@integer/semi_bold"
            android:layout_marginStart="@dimen/value_52dp"
            android:layout_marginTop="@dimen/value_10dp"/>
        
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/value_340dp"
            android:layout_marginStart="@dimen/value_24dp"
            android:layout_marginEnd="@dimen/value_24dp"
            android:layout_marginTop="@dimen/value_12dp"
            app:cardCornerRadius="@dimen/value_8dp"
            android:background="@color/white"
            android:backgroundTint="@color/white">
            
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/value_2dp"
                android:src="@drawable/medical_certificate"/>

        </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/medical_certificate"
                android:fontFamily="@font/inter_font"
                android:textSize="@dimen/value_17dp"
                android:textColor="@color/black"
                android:textFontWeight="@integer/semi_bold"
                android:layout_marginStart="@dimen/value_52dp"
                android:layout_marginTop="@dimen/value_24dp"
                android:layout_marginBottom="@dimen/value_25dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/value_340dp"
                android:layout_marginStart="@dimen/value_24dp"
                android:layout_marginEnd="@dimen/value_24dp"
                android:layout_marginTop="@dimen/value_12dp"
                app:cardCornerRadius="@dimen/value_8dp"
                android:background="@color/white"
                android:backgroundTint="@color/white"
                android:layout_marginBottom="@dimen/value_8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/value_2dp"
                    android:src="@drawable/medical_certificate"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>


    </ScrollView>

</LinearLayout>