<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".view.Dashboard.navigationfragments.ServicesFragment">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/maroon" />

    <Toolbar
        android:id="@+id/services_toolbar"
        android:layout_width="match_parent"
        android:background="@android:color/transparent"
        android:layout_height="@dimen/value_50dp"
        android:paddingEnd="@dimen/value_18dp"
        tools:ignore="MissingClass">

        <TextView
            android:id="@+id/services_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Insurance Services "
            android:textFontWeight="@integer/bold"
            android:fontFamily="@font/inter_font"
            android:textColor="@color/black"
            android:textSize="@dimen/value_26dp"
            android:layout_marginStart="@dimen/value_16dp"/>

    </Toolbar>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/value_0dp"
        android:layout_weight="1"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/open_button"
        android:layout_width="@dimen/value_55dp"
        android:layout_height="@dimen/value_60dp"
        android:layout_gravity="center"
        android:backgroundTint="@color/pink_3"
        android:layout_marginBottom="@dimen/value_28dp"
        app:shapeAppearanceOverlay="@style/CustomFABShape"
        android:src="@drawable/ic_double_arrow_up"
        app:tint="@color/maroon"
        app:maxImageSize="@dimen/value_34dp"/>


</LinearLayout>