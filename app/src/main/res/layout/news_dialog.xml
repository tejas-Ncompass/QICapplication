<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/value_16dp"
        android:layout_marginEnd="@dimen/value_16dp"
        android:layout_marginTop="@dimen/value_16dp"
        android:layout_marginBottom="@dimen/value_10dp"
        app:cardCornerRadius="@dimen/value_14dp"
        android:backgroundTint="@color/green">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView6"
                android:layout_width="@dimen/value_40dp"
                android:layout_height="@dimen/value_40dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/yellow"
                app:cardCornerRadius="@dimen/value_12dp"
                app:cardElevation="@dimen/value_0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="@dimen/value_26dp"
                    android:layout_height="@dimen/value_26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/idea_icon" />
            </androidx.cardview.widget.CardView>

            <ImageView
                android:id="@+id/close_dialog"
                android:layout_width="@dimen/value_22dp"
                android:layout_height="@dimen/value_22dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/inter_font"
                android:textColor="@color/white"
                android:textSize="@dimen/value_16dp"
                app:layout_constraintStart_toEndOf="@+id/cardView6"
                app:layout_constraintTop_toTopOf="parent"
                android:text="@string/k_snippet" />

            <TextView
                android:id="@+id/dialog_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/inter_font"
                android:textColor="@color/light_green"
                android:textSize="@dimen/value_12dp"
                app:layout_constraintStart_toEndOf="@+id/cardView6"
                app:layout_constraintTop_toBottomOf="@+id/dialog_title"
                android:text="@string/team_admin" />

            <TextView
                android:id="@+id/dialog_content_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter_font"
                android:textColor="@color/white"
                android:textFontWeight="@integer/semi_bold"
                android:textSize="@dimen/value_17dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardView6"
                android:text="@string/content_heading" />

            <TextView
                android:id="@+id/dialog_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/inter_font"
                android:textColor="@color/light_green"
                android:textSize="@dimen/value_8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dialog_content_heading"
                android:text="@string/news_dialog_content"
                android:paddingBottom="@dimen/value_22dp"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>