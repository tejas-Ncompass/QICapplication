<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTintMode="screen"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".activities.MainActivity">


    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="@dimen/value_514dp"
        android:layout_height="@dimen/value_482dp"
        android:layout_weight="3"
        android:layout_gravity="center"
        app:srcCompat="@drawable/qicpageone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="2">
    <ImageView
        android:id="@+id/view_logo"
        android:layout_width="@dimen/value_166dp"
        android:layout_height="@dimen/value_100dp"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/value_30dp"
        app:srcCompat="@drawable/qiclogo" />

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="@dimen/value_90dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/value_8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/maroon" />
    </LinearLayout>

</LinearLayout>