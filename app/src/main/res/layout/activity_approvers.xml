<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".view.Approval.ApproversActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/approvers_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/value_60dp"
        android:paddingStart="@dimen/value_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="@dimen/value_60dp"
        android:layout_height="@dimen/value_60dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/progress_person_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/approvers_toolbar" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="60dp"
        android:fontFamily="@font/inter_font"
        android:text="@string/appr"
        android:textColor="@color/hint_color"
        android:textFontWeight="@integer/medium"
        android:textSize="@dimen/value_13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/imageView4"
        app:layout_constraintTop_toBottomOf="@+id/approvers_toolbar" />

    <View
        android:id="@+id/view"
        android:layout_width="@dimen/value_1dp"
        android:layout_height="@dimen/value_40dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="2dp"
        android:background="@color/green_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView4" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView2"
        android:layout_width="@dimen/value_32dp"
        android:layout_height="@dimen/value_32dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="2dp"
        app:cardCornerRadius="@dimen/value_4dp"
        app:cardElevation="@dimen/value_0dp"
        android:background="@color/white"
        android:backgroundTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/n_border" />

    </androidx.cardview.widget.CardView>

    <View
        android:id="@+id/view2"
        android:layout_width="@dimen/value_1dp"
        android:layout_height="@dimen/value_40dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="2dp"
        android:background="@color/green_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView2" />

    <ImageView
        android:layout_width="@dimen/value_20dp"
        android:layout_height="@dimen/value_20dp"
        android:layout_gravity="bottom|end"
        android:layout_marginStart="66dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ok_badge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cardView2" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView3"
        android:layout_width="@dimen/value_32dp"
        android:layout_height="@dimen/value_32dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="2dp"
        app:cardCornerRadius="@dimen/value_4dp"
        app:cardElevation="@dimen/value_0dp"
        android:background="@color/white"
        android:backgroundTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view2">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/profile_2_border" />

    </androidx.cardview.widget.CardView>

    <ImageView
        android:layout_width="@dimen/value_20dp"
        android:layout_height="@dimen/value_20dp"
        android:layout_gravity="bottom|end"
        android:layout_marginStart="66dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ok_badge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cardView3" />

    <View
        android:id="@+id/view3"
        android:layout_width="@dimen/value_1dp"
        android:layout_height="@dimen/value_40dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="2dp"
        android:background="@color/no_red"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView3" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView4"
        android:layout_width="@dimen/value_32dp"
        android:layout_height="@dimen/value_32dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="2dp"
        app:cardCornerRadius="@dimen/value_4dp"
        app:cardElevation="@dimen/value_0dp"
        android:background="@color/white"
        android:backgroundTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view3">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/sophia_border" />
    </androidx.cardview.widget.CardView>

    <ImageView
        android:layout_width="@dimen/value_20dp"
        android:layout_height="@dimen/value_20dp"
        android:layout_gravity="bottom|end"
        android:layout_marginStart="66dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/no_badge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cardView4" />

    <View
        android:id="@+id/view4"
        android:layout_width="@dimen/value_1dp"
        android:layout_height="@dimen/value_40dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="2dp"
        android:background="@color/line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView4" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView5"
        android:layout_width="@dimen/value_32dp"
        android:layout_height="@dimen/value_32dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="2dp"
        app:cardCornerRadius="@dimen/value_4dp"
        app:cardElevation="@dimen/value_0dp"
        android:background="@color/white"
        android:backgroundTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view4">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/profile_3" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="140dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@+id/cardView2"
        app:layout_constraintTop_toBottomOf="@+id/approvers_toolbar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_font"
            android:text="@string/nico"
            android:textColor="@color/black"
            android:textFontWeight="@integer/semi_bold"
            android:textSize="@dimen/value_17dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_font"
            android:text="@string/nico_designantion"
            android:textColor="@color/hint_color"
            android:textSize="@dimen/value_13dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@+id/cardView3"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_font"
            android:text="@string/max_verstappen"
            android:textColor="@color/black"
            android:textFontWeight="@integer/semi_bold"
            android:textSize="@dimen/value_17dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_font"
            android:text="@string/max_designation"
            android:textColor="@color/hint_color"
            android:textSize="@dimen/value_13dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@+id/cardView4"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout4">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_font"
            android:text="@string/sophia_jacobs"
            android:textColor="@color/black"
            android:textFontWeight="@integer/semi_bold"
            android:textSize="@dimen/value_17dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_font"
            android:text="@string/sophia_designation"
            android:textColor="@color/hint_color"
            android:textSize="@dimen/value_13dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@+id/cardView5"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout5">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_font"
            android:text="@string/allen"
            android:textColor="@color/black"
            android:textFontWeight="@integer/semi_bold"
            android:textSize="@dimen/value_17dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_font"
            android:text="@string/allen_designation"
            android:textColor="@color/hint_color"
            android:textSize="@dimen/value_13dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="140dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/inter_font"
        android:text="@string/t_10.30"
        android:textColor="@color/grey_3"
        android:textSize="@dimen/value_13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/linearLayout3"
        app:layout_constraintTop_toBottomOf="@+id/approvers_toolbar" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/inter_font"
        android:text="@string/t_11.10"
        android:textColor="@color/grey_3"
        android:textSize="@dimen/value_13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/linearLayout4"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/inter_font"
        android:text="@string/t_11.20"
        android:textColor="@color/grey_3"
        android:textSize="@dimen/value_13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/linearLayout5"
        app:layout_constraintTop_toBottomOf="@+id/textView5" />


</androidx.constraintlayout.widget.ConstraintLayout>