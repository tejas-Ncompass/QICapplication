<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.QICApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="toolbar_title" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">@dimen/value_18dp</item>
        <item name="android:fontFamily">@font/inter_font</item>
    </style>

    <style name="roundedCorners" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/white</item>
    </style>

    <style name="NavMenuTextStyle" parent="android:Widget.TextView">
        <item name="android:textSize">@dimen/value_10dp</item>
    </style>

    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="fontFamily">@font/inter_font</item>
        <item name="android:textFontWeight">@integer/medium</item>
        <item name="android:textSize">@dimen/value_15dp</item>
    </style>

    <style name="ToolbarTextStyle" parent="TextAppearance.AppCompat.Title">
        <item name="fontFamily">@font/inter_font</item>
        <item name="android:textSize">@dimen/value_13dp</item>
    </style>

    <style name="NewsToolbarTextStyle" parent="TextAppearance.AppCompat.Title">
        <item name="fontFamily">@font/inter_font</item>
        <item name="android:textSize">@dimen/value_26dp</item>
        <item name="android:textFontWeight">@integer/bold</item>
    </style>

    <style name="CustomFABShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/value_30dp</item>
    </style>

    <style name="BottomSheetStyle" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetDialogTheme</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Widget.Design.BottomSheet.Modal">
        <item name="background">@android:color/transparent</item>
    </style>

    <style name="Theme.QICApplication" parent="Base.Theme.QICApplication" />
</resources>